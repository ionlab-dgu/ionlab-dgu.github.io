---
import InternalLayout from '../../layouts/InternalLayout.astro';
import PageHeader from '../../components/common/PageHeader.astro';
import EmptyState from '../../components/common/EmptyState.astro';
import DeadlineList from '../../components/internal/DeadlineList.astro';
import { fetchAllEvents, upcomingEvents, calendarMeta } from '../../lib/gcal';
import { calendars } from '../../lib/config';
import { dayKey } from '../../lib/attendance';
import { getConferenceDeadlines } from '../../lib/deadlines';

const events = await fetchAllEvents();
const today = dayKey();

// 오늘 이후 60일치만. 비교는 표시 시간대의 날짜(e.day)로 합니다 —
// start 는 UTC라 잘라 쓰면 경계 일정이 하루씩 밀립니다.
const upcoming = upcomingEvents(events, 60);

// 날짜별 그룹
const byDay = new Map<string, typeof upcoming>();
for (const e of upcoming) {
  if (!byDay.has(e.day)) byDay.set(e.day, []);
  byDay.get(e.day)!.push(e);
}
const days = [...byDay.entries()];

const configured = (calendars.calendars ?? []).length;

// 학회 마감도 같은 화면에서 봅니다. 과제 마감은 /internal/deadlines 에 있습니다 —
// 여기서는 '일정'만 다루고 과제 리포트는 성격이 달라 섞지 않습니다.
const deadlines = getConferenceDeadlines({ withinDays: 60 });

function dayLabel(d: string): string {
  const date = new Date(`${d}T00:00:00+09:00`);
  const weekday = date.toLocaleDateString('ko-KR', { weekday: 'short', timeZone: 'Asia/Seoul' });
  return `${d} (${weekday})${d === today ? ' · 오늘' : ''}`;
}
---

<InternalLayout title="캘린더">
  <PageHeader
    title="캘린더"
    description="Google Calendar가 정본입니다. 이 화면은 읽기 전용이며, 일정 추가·수정은 GCal에서 하세요."
  />

  {
    days.length === 0 ? (
      <EmptyState
        title={
          configured === 0 ? '연결된 캘린더가 없습니다' : '앞으로 60일간 등록된 일정이 없습니다'
        }
        hint={
          configured === 0
            ? '모든 캘린더는 internal 이라 iCal 주소를 env_var 로 넘겨야 합니다 (config/calendars.yaml 참고). ical_url 에 직접 넣으면 공개 배포본에 실릴 수 있습니다.'
            : '캘린더는 연결되어 있지만 표시할 일정이 없습니다. GCal에 일정을 추가하면 다음 빌드부터 나타납니다.'
        }
        icon="◷"
      />
    ) : (
      <div class="space-y-8">
        {days.map(([day, dayEvents]) => (
          <section>
            <h2
              class:list={[
                'mb-2 font-mono text-sm font-semibold',
                day === today
                  ? 'text-brand-700 dark:text-brand-300'
                  : 'text-gray-500 dark:text-gray-400',
              ]}
            >
              {dayLabel(day)}
            </h2>
            <ul class="divide-y divide-gray-200 dark:divide-gray-800">
              {dayEvents.map((e) => (
                <li class="flex items-baseline gap-4 py-2.5">
                  <time class="w-16 shrink-0 font-mono text-sm text-gray-500 tabular-nums dark:text-gray-400">
                    {e.time ?? '종일'}
                  </time>
                  <div class="min-w-0">
                    <p>{e.summary}</p>
                    <p class="text-xs text-gray-500 dark:text-gray-400">
                      {[calendarMeta(e.calendar)?.label, e.location].filter(Boolean).join(' · ')}
                    </p>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    )
  }

  <section class="mt-12 border-t border-gray-200 pt-6 dark:border-gray-800">
    <h2 class="mb-3 font-semibold">
      학회 마감
      <span class="text-sm font-normal text-gray-500 dark:text-gray-400"> 앞으로 60일 </span>
    </h2>
    <DeadlineList
      deadlines={deadlines}
      emptyHint="content/conferences.yaml 의 tracked_venues 에 관심 학회를 추가하세요. 날짜는 주 1회 자동으로 갱신됩니다."
    />
    <p class="mt-3 text-sm text-gray-500 dark:text-gray-400">
      과제 리포트 마감은 <a href="/internal/deadlines" class="link">데드라인</a> 에 있습니다.
    </p>
  </section>

  {
    configured > 0 && (
      <section class="mt-12 border-t border-gray-200 pt-6 dark:border-gray-800">
        <h2 class="text-sm font-semibold text-gray-500 dark:text-gray-400">연결된 캘린더</h2>
        <ul class="mt-2 space-y-1 text-sm">
          {(calendars.calendars ?? []).map((c) => (
            <li class="flex flex-wrap items-baseline gap-2">
              <span>{c.label}</span>
              <span class="badge badge-neutral">{c.visibility === 'public' ? '공개' : '내부'}</span>
              {c.description && (
                <span class="text-gray-500 dark:text-gray-400">{c.description}</span>
              )}
            </li>
          ))}
        </ul>
      </section>
    )
  }
</InternalLayout>
