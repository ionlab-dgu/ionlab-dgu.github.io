---
import PublicLayout from '../../layouts/PublicLayout.astro';
import PageHeader from '../../components/common/PageHeader.astro';
import Card from '../../components/common/Card.astro';
import ProjectCard from '../../components/public/ProjectCard.astro';
import EmptyState from '../../components/common/EmptyState.astro';
import { getPublicResearchProjects, getResearchDirections } from '../../lib/content';
import { site, filled } from '../../lib/config';

const projects = getPublicResearchProjects();
const directions = getResearchDirections();
---

<PublicLayout title="Research" description="ION Lab의 연구 분야와 진행 중인 프로젝트">
  <PageHeader title="Research" description={filled(site.lab?.tagline_ko)} />

  {
    directions.length > 0 && (
      <section class="mb-12">
        <div class="flex items-baseline justify-between">
          <h2 class="text-sm font-semibold tracking-wide text-gray-500 uppercase dark:text-gray-400">
            Research Directions
          </h2>
          <a href="/research/directions" class="link text-sm">
            전체 보기 →
          </a>
        </div>
        <div class="mt-4 grid gap-4 sm:grid-cols-3">
          {directions.map((direction) => {
            const d = direction.data;
            const short = filled(d.short);
            return (
              <Card href={`/research/directions/${d.slug}`}>
                <p class="text-brand-700 dark:text-brand-300 font-mono text-xs font-medium">
                  {String(d.order).padStart(2, '0')}
                </p>
                <h3 class="mt-1 font-semibold">{d.name_ko ?? d.name_en}</h3>
                {short && <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">{short}</p>}
              </Card>
            );
          })}
        </div>
      </section>
    )
  }

  <section>
    <h2 class="mb-4 text-sm font-semibold tracking-wide text-gray-500 uppercase dark:text-gray-400">
      Projects
    </h2>
    {
      projects.length === 0 ? (
        <EmptyState
          title="공개된 연구 프로젝트가 없습니다"
          hint="content/research/<slug>/index.md 를 만들면 여기에 표시됩니다. _template/ 폴더를 복사해 시작하세요."
          command="pnpm new:project"
        />
      ) : (
        <div class="grid gap-4 sm:grid-cols-2">
          {projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      )
    }
  </section>
</PublicLayout>
