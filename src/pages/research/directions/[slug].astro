---
import PublicLayout from '../../../layouts/PublicLayout.astro';
import Prose from '../../../components/common/Prose.astro';
import ProjectCard from '../../../components/public/ProjectCard.astro';
import EmptyState from '../../../components/common/EmptyState.astro';
import { getResearchDirections, getPublicProjectsByDirection } from '../../../lib/content';
import { filled } from '../../../lib/config';

export function getStaticPaths() {
  return getResearchDirections().map((direction) => ({
    params: { slug: direction.data.slug },
    props: { direction },
  }));
}

const { direction } = Astro.props;
const d = direction.data;
const short = filled(d.short);
const description = filled(d.description);
const topics = (d.topics ?? []).filter(Boolean);
const projects = getPublicProjectsByDirection(d.slug);
---

<PublicLayout title={d.name_ko ?? d.name_en} description={short}>
  <a href="/research/directions" class="link text-sm">← Research Directions</a>

  <p class="text-brand-700 dark:text-brand-300 mt-6 font-mono text-sm font-medium">
    {String(d.order).padStart(2, '0')}
  </p>
  <h1 class="mt-1 text-3xl font-bold tracking-tight">{d.name_ko ?? d.name_en}</h1>
  {
    d.name_ko && d.name_en && (
      <p class="mt-1 text-lg text-gray-500 dark:text-gray-400">{d.name_en}</p>
    )
  }
  {short && <p class="mt-3 max-w-2xl text-lg text-gray-600 dark:text-gray-400">{short}</p>}

  {
    description && (
      <div class="mt-8 max-w-2xl text-gray-700 dark:text-gray-300">
        <p>{description}</p>
      </div>
    )
  }

  {
    topics.length > 0 && (
      <section class="mt-8 max-w-2xl">
        <h2 class="mb-2 text-sm font-semibold tracking-wide text-gray-500 uppercase dark:text-gray-400">
          Topics
        </h2>
        <ul class="list-inside list-disc space-y-1 text-gray-700 dark:text-gray-300">
          {topics.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      </section>
    )
  }

  {
    direction.body && (
      <div class="mt-10 max-w-3xl border-t border-gray-200 pt-8 dark:border-gray-800">
        <Prose body={direction.body} />
      </div>
    )
  }

  <section class="mt-12">
    <h2 class="mb-4 text-xl font-bold tracking-tight">Related Projects</h2>
    {
      projects.length === 0 ? (
        <EmptyState
          title="이 방향에 연결된 공개 프로젝트가 없습니다"
          hint={`content/research/<slug>/index.md 의 direction 필드에 '${d.slug}'를 적으면 여기에 표시됩니다.`}
        />
      ) : (
        <div class="grid gap-4 sm:grid-cols-2">
          {projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      )
    }
  </section>
</PublicLayout>
