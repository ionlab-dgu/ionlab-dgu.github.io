---
/**
 * Lab Brain 안내 배너.
 *
 * 핸드북 상단에 "규정을 즉답으로 물어볼 수 있다"고 알려줍니다.
 * labBrainUrl 이 비어 있으면(설정 TODO) 아무것도 렌더하지 않습니다.
 * 강요가 아닌 안내 톤 — 핸드북 문서는 그대로 있고, 빠른 답이 필요할 때의 보조 수단.
 */
import { labBrainUrl } from '../../lib/config';
---

{
  labBrainUrl && (
    <aside
      class="border-brand-400 mb-8 flex flex-col gap-3 rounded-lg border bg-brand-50/60 p-4 sm:flex-row sm:items-center sm:justify-between dark:border-brand-400/40 dark:bg-brand-400/10"
    >
      <p class="text-sm text-gray-700 dark:text-gray-200">
        <span aria-hidden="true">💡</span> 규정 관련 즉답이 필요하면{' '}
        <span class="font-medium text-gray-900 dark:text-gray-100">Lab Brain</span>에
        물어보세요. 이 핸드북과 같은 내용을 바탕으로 답합니다.
      </p>
      <a
        href={labBrainUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Lab Brain에 규정·정책 질문하기 (외부 링크, 새 탭)"
        class="bg-brand-400 hover:bg-brand-500 focus-visible:ring-brand-700 dark:focus-visible:ring-brand-300 inline-flex shrink-0 items-center gap-1.5 self-start rounded-lg px-4 py-2 text-sm font-medium text-gray-950 transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none sm:self-auto dark:focus-visible:ring-offset-gray-950"
      >
        <span aria-hidden="true">🧠</span>
        Lab Brain 열기
        <span aria-hidden="true">→</span>
      </a>
    </aside>
  )
}
